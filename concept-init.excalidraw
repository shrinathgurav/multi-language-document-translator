      "link": null,
      "locked": false,
      "text": "doc_translator_app/\n│\n├── app.py                      # Main Streamlit UI entry point (handles streaming output & downloads)\n├── requirements.txt            # All Python dependencies\n├── config.py                   # App constants (5000 char limit, supported languages, file extensions)\n│\n├── core/                       # Core business logic modules\n│   ├── __init__.py\n│   ├── extractor.py            # Extracts text from PDF, DOCX, TXT, and images (OCR)\n│   ├── chunker.py              # Splits text at sentence boundaries under 5000 chars\n│   ├── translator.py           # Wrapper around free Google Translate web library\n│   └── exporter.py             # Saves/exports translated text to PDF, DOCX, or TXT\n│\n├── utils/                      # Helper utilities\n│   ├── __init__.py\n│   └── file_helpers.py         # Temp file handling, mime-type checks, cleanup\n│\n└── assets/                     # Optional static files (custom fonts for PDF export, icons)\n    └── NotoSans-Regular.ttf    # Unicode font needed for exporting non-Latin scripts to PDF\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "nGzGujY10gZRzN5r6weDS",
      "originalText": "doc_translator_app/\n│\n├── app.py                      # Main Streamlit UI entry point (handles streaming output & downloads)\n├── requirements.txt            # All Python dependencies\n├── config.py                   # App constants (5000 char limit, supported languages, file extensions)\n│\n├── core/                       # Core business logic modules\n│   ├── __init__.py\n│   ├── extractor.py            # Extracts text from PDF, DOCX, TXT, and images (OCR)\n│   ├── chunker.py              # Splits text at sentence boundaries under 5000 chars\n│   ├── translator.py           # Wrapper around free Google Translate web library\n│   └── exporter.py             # Saves/exports translated text to PDF, DOCX, or TXT\n│\n├── utils/                      # Helper utilities\n│   ├── __init__.py\n│   └── file_helpers.py         # Temp file handling, mime-type checks, cleanup\n│\n└── assets/                     # Optional static files (custom fonts for PDF export, icons)\n    └── NotoSans-Regular.ttf    # Unicode font needed for exporting non-Latin scripts to PDF\n",
      "autoResize": true,
